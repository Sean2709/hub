---
import '../styles/global.css';
import { profile, analytics } from '../data/site';
import Mark from '../components/Mark.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean; // data-heavy pages (/bedrock/) get a wider column
  noindex?: boolean; // private pages (/admin/): robots noindex, no beacon
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.tagline,
  wide = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site).href; // 1200x630, source public/og.svg
const beaconUrl = `${analytics.endpoint}/collect?k=${analytics.siteKey}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#059669" />
    <link rel="alternate" type="application/rss+xml" title="velog @seanson2709" href={profile.links.rss} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="hub.sean-chloe.com" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — hub.sean-chloe.com`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
  </head>
  <body class:list={[{ wide }]}>
    <header class="site-header">
      <a class="brand" href="/" aria-label="홈"><Mark uid="hdr" /></a>
      <nav aria-label="주요">
        <a href="/#tools">Tools</a>
        <a href="/#apps">Apps</a>
        <a href="/#writing">Writing</a>
        <a href="/#certs">Certs</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span class="dot">·</span>
      <span>Built with Astro, deployed via GitHub Pages</span>
      <p class="disclaimer">{profile.disclaimer}<br /><span lang="en">{profile.disclaimerEn}</span></p>
    </footer>
    {!noindex && (
      <script is:inline define:vars={{ beaconUrl }}>
        // Cookie-less pageview + outbound-click beacon (see infra/analytics/).
        // Sends path, referrer, viewport width, language — nothing that identifies a person.
        // Opt-out for the owner: localStorage['hub.notrack']='1' (set by /admin/).
        (function () {
          try {
            if (localStorage.getItem('hub.notrack') === '1') return;
          } catch (e) {}
          var send = function (o) {
            o.p = location.pathname;
            o.r = document.referrer || '';
            o.w = window.innerWidth;
            o.l = navigator.language || '';
            var body = JSON.stringify(o); // string body = text/plain → no CORS preflight
            if (navigator.sendBeacon) navigator.sendBeacon(beaconUrl, body);
            else fetch(beaconUrl, { method: 'POST', body: body, keepalive: true, mode: 'no-cors' }).catch(function () {});
          };
          send({ t: 'pv' });
          document.addEventListener(
            'click',
            function (e) {
              var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
              if (!a) return;
              var href = a.href || '';
              if (!/^https?:/i.test(href) || a.host === location.host) return;
              send({ t: 'click', h: href.slice(0, 300) });
            },
            true
          );
        })();
      </script>
    )}
  </body>
</html>
