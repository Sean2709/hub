---
// /orunka/login/ — 오룬카 게임의 로그인 다리(Apple · Google). 게임(맥·윈도우·iPhone)이 브라우저로 이 페이지를 연다:
//   ?cb=http://127.0.0.1:<포트>/cb (게임이 잠깐 여는 로컬 수신) 또는 orunka://auth (iPhone 앱 — ASWebAuthenticationSession 시트) · &state=<게임이 만든 값>
//   &only=apple (Apple 단추만) · &why=delete (서버 저장 지우기 — Apple 토큰 회수용 새 인가 코드)
// Google: GIS(hub 클라이언트) → Google ID 토큰(1시간)을 cb 로. Apple: appleid.apple.com 리디렉트(scope 없음, fragment) → 이 페이지로 돌아와
//   id_token·code·원래 nonce 를 cb 로(prov=apple.com). Firebase 로그인은 게임이 직접 한다.
// cb 검사가 보안 핵심(토큰을 엉뚱한 곳으로 보내지 않게) — src/lib/orunka-login.ts. 계약 = OrunkaUnity/tools/cloud/README.md
import Base from '../../layouts/Base.astro';
import { admin } from '../../data/site';
---

<Base title="오룬카 — 로그인" description="오룬카 서버 저장 로그인" noindex>
  <article id="ol" data-client-id={admin.googleClientId}>
    <h1 id="ol-h">오룬카 — 로그인</h1>
    <p id="ol-lead">로그인하면 게임 저장이 서버에도 올라가 <strong>맥·윈도우·아이폰</strong> 어디서든 같은 모험을 이어할 수 있어요.</p>
    <div class="ol-btns">
      <button type="button" id="ol-apple" class="ol-apple" hidden>
        <svg viewBox="0 0 17 20" aria-hidden="true"><path fill="currentColor" d="M14.06 10.62c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.87-.76-1.47.02-2.83.86-3.59 2.18-1.54 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.24 2.73 2.2 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.32-3.5zM11.9 4.13c.6-.74 1.01-1.75.9-2.77-.87.04-1.93.58-2.55 1.31-.56.64-1.05 1.68-.92 2.67.97.07 1.96-.49 2.57-1.21z"/></svg>
        <span>Apple로 계속하기</span>
      </button>
      <div id="ol-btn" class="ol-btn"></div>
    </div>
    <p id="ol-msg" class="ol-msg"></p>
    <p class="ol-note"><small>로그인 계정의 고유 번호(Google은 이메일도)는 로그인에만 쓰고, 게임 저장(캐릭터·펫·가방·놀이 시간)은 서버(Google Firebase, 서울)에 보관해요. Apple 로그인은 이름·이메일을 받지 않아요. 광고·판매·분석에는 쓰지 않으며, 게임 제목 화면의 '서버 저장 지우기'나 <a href="mailto:seanson2709@gmail.com">이메일</a>로 언제든 지울 수 있어요.</small></p>
  </article>
  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
</Base>

<style>
  .ol-btns { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; margin: 1.4rem 0 .6rem; }
  .ol-btn { min-height: 44px; }
  .ol-apple { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-width: 240px; height: 44px; padding: 0 1.4rem;
    border: 0; border-radius: 999px; background: #000; color: #fff; font: 600 1rem/1 -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif; cursor: pointer; }
  .ol-apple svg { width: 17px; height: 20px; margin-top: -2px; }
  .ol-apple:disabled { opacity: .5; cursor: default; }
  .ol-msg { font-weight: 600; }
  .ol-msg.err { color: #dc2626; }
  .ol-note { color: var(--muted); margin-top: 2rem; }
</style>

<script>
  import { validCb, validState, backUrl, appleAuthUrl, appleReturn, randomHex, sha256hex, APPLE_SS, type AppleSaved } from '../../lib/orunka-login';
  const $ = (id: string) => document.getElementById(id)!;
  const root = $('ol');
  const msg = $('ol-msg');
  const say = (t: string, err = false) => { msg.textContent = t; msg.className = 'ol-msg' + (err ? ' err' : ''); };
  let sent = false;
  const go = (cb: string, state: string, kv: Record<string, string>) => { if (sent) return; sent = true; location.replace(backUrl(cb, state, kv)); };
  const doneMsg = (cb: string) => say(cb === 'orunka://auth' ? '로그인 됐어요 — 앱으로 돌아가요.' : '로그인 됐어요 — 게임으로 돌아가세요(이 창은 닫아도 돼요).');
  const deleting = (why?: string | null) => {
    if (why !== 'delete') return;
    $('ol-h').textContent = '오룬카 — 서버 저장 지우기';
    $('ol-lead').textContent = '서버 저장을 지우기 전에 Apple로 한 번 더 로그인해 주세요. 오룬카와 Apple 계정의 연결도 함께 끊어요.';
  };

  // ---- Apple 에서 돌아옴(#code=…&id_token=…&state=…) -----------------------------------------
  if (/[#&](id_token|error)=/.test(location.hash)) {
    let saved: AppleSaved | null = null;
    try { saved = JSON.parse(sessionStorage.getItem(APPLE_SS) || 'null'); } catch {}
    sessionStorage.removeItem(APPLE_SS);
    const r = appleReturn(location.hash, saved);
    history.replaceState(null, '', location.pathname); // 토큰을 주소창·기록에서 지운다
    deleting(saved?.why);
    if (r.ok) { doneMsg(r.cb); go(r.cb, r.state, r.kv); }
    else {
      say(r.msg, true);
      if (r.cb && r.state) go(r.cb, r.state, { err: r.msg }); // 게임이 기다리지 않게 실패도 돌려보낸다
    }
  } else {
    // ---- 게임에서 처음 열림 ---------------------------------------------------------------
    const qs = new URLSearchParams(location.search);
    const cb = qs.get('cb'), state = qs.get('state'), only = qs.get('only'), why = qs.get('why');
    if (!validCb(cb) || !validState(state)) {
      say('게임에서 연 주소가 아니에요 — 오룬카 제목 화면의 "로그인"을 눌러 다시 열어 주세요.', true);
    } else {
      deleting(why);
      const apple = $('ol-apple') as HTMLButtonElement;
      apple.hidden = false;
      apple.addEventListener('click', async () => {
        apple.disabled = true;
        const as = randomHex(16), nonce = randomHex(32);
        const s: AppleSaved = { cb: cb!, state: state!, as, nonce, ...(why ? { why } : {}) };
        sessionStorage.setItem(APPLE_SS, JSON.stringify(s));
        say('Apple 로그인으로 가는 중…');
        location.assign(appleAuthUrl(as, await sha256hex(nonce)));
      });
      if (only === 'apple') {
        $('ol-btn').hidden = true;
        say('Apple로 로그인해 주세요.');
      } else {
        const onCredential = (r: { credential?: string }) => {
          if (!r?.credential) { say('Google 로그인이 끝나지 않았어요 — 다시 눌러 주세요.', true); return; }
          doneMsg(cb!);
          go(cb!, state!, { idt: r.credential, prov: 'google.com' });
        };
        let n = 0;
        const iv = window.setInterval(() => {
          const g = (window as any).google?.accounts?.id;
          if (g) {
            clearInterval(iv);
            g.initialize({ client_id: root.dataset.clientId, callback: onCredential, auto_select: false, cancel_on_tap_outside: false, itp_support: true, context: 'signin' });
            g.renderButton($('ol-btn'), { theme: 'outline', size: 'large', text: 'continue_with', shape: 'pill', locale: 'ko', width: 240 });
            say(cb === 'orunka://auth' ? '로그인하면 앱으로 돌아가요.' : '로그인하면 게임이 알아서 이어받아요.');
          } else if (++n > 100) {
            clearInterval(iv);
            say('Google 로그인 스크립트를 불러오지 못했어요 — Apple로 로그인하거나 차단 확장 프로그램·네트워크를 확인해 주세요.', true);
          }
        }, 100);
      }
    }
  }
</script>
