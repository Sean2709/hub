---
// /admin/ — owner-only dashboard. The HTML itself is public (static site) but shows
// nothing until you sign in with Google as the admin account. The Google ID token
// (1 h) is sent as a bearer to the analytics API, whose Lambda authorizer verifies
// signature / aud / exp / e-mail — the client-side e-mail check here is UX only.
// noindex + excluded from sitemap; linked from the header menu (rel=nofollow).
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { analytics, admin } from '../../data/site';
import '../../lib/knowthat-admin.css';
import '../../lib/orunka-cloud.css';
import '../../lib/agentroom-chat.css';
import '../../lib/agentroom-history.css';
import '../../styles/admin.css';

// 왼쪽 메뉴 — [해시 값, 이름, 아이콘 path]. data-view / data-app 은 스크립트가 쓰는 고리
const NAV_VIEWS: [string, string, string][] = [
  ['visitors', '접속자', '<path d="M4 20h16" /><path d="M6.5 16.5v-5M11 16.5V6M15.5 16.5v-8M20 16.5v-3" />'],
];
const NAV_APPS: [string, string, string][] = [
  ['seanchat', 'SeanChat', '<path d="M4 5.5h16v10.5H10l-5 4v-4H4z" />'],
  ['jaksim', '작심', '<circle cx="12" cy="12" r="8.5" /><path d="M8.2 12.4l2.6 2.6 5-5.4" />'],
  ['mansur', '만수르', '<rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M3 10.5h18M15.5 14.5h2" />'],
  ['knowthat', '너그거알아', '<path d="M9.5 18h5M10.5 21h3" /><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.3 1.1 2.2h5c0-.9.4-1.6 1.1-2.2A6 6 0 0 0 12 3z" />'],
  ['orunka', '오룬카', '<rect x="2.5" y="7" width="19" height="11" rx="4" /><path d="M7 12.5h4M9 10.5v4M15.5 11.5h.01M18 13.5h.01" />'],
  ['room', '에이전트 방', '<path d="M3 4.5h12v8.5H8l-5 4z" /><path d="M15 8.5h6V17l-3.5-2.5H11V13" />'],
  ['roomlog', '방 기록', '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5z" /><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5a1.5 1.5 0 0 1 1.5 1.5z" />'],
];
// 해시가 #app-<id> 가 아닌 앱 화면(짧은 주소) — 스크립트의 HASH_ALIAS 와 같게
const appHref = (app: string) => (app === 'roomlog' ? '#roomlog' : `#app-${app}`);
// 디자인 규칙 한곳: 카드 · 카드 머리 · 메뉴 줄 · 화면 제목/설명
const card = 'min-w-0 rounded-card border border-line bg-card shadow-card';
const box = `${card} mt-3.5 px-4 pt-3.5 pb-4`;
const boxHead = 'mb-2.5 flex items-baseline justify-between gap-2 [&_h3]:m-0 [&_h3]:text-[14.5px] [&_h3]:font-semibold [&>span]:text-xs [&>span]:text-mute';
const navA =
  'flex items-center gap-2.5 rounded-[9px] px-2.5 py-2 text-[14px] whitespace-nowrap text-ink transition-colors hover:bg-hov ' +
  'aria-[current=page]:bg-brand-soft aria-[current=page]:font-semibold aria-[current=page]:text-brand ' +
  '[&>svg]:size-[18px] [&>svg]:opacity-70 aria-[current=page]:[&>svg]:opacity-100 ' +
  'narrow:flex-none narrow:gap-1.5 narrow:px-3 narrow:py-1.5 narrow:text-[13px] narrow:[&>svg]:size-[15px]';
const viewHead = 'mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1 [&_h2]:m-0 [&_h2]:border-0 [&_h2]:p-0 [&_h2]:text-[20px] [&_h2]:font-bold [&_h2]:tracking-tight narrow:[&_h2]:text-[18px]';
const viewLead = 'view-lead mt-0 mb-4 max-w-[80ch] text-[13px] leading-relaxed text-mute empty:hidden';
const kpi = `${card} kpi px-4 pt-3.5 pb-3 phone:px-3.5`;
const kpiL = 'flex items-center gap-1.5 text-xs font-medium text-mute';
const kpiN = 'mt-1 text-[28px] leading-tight font-bold tracking-tight tabular-nums phone:text-[24px] [&_small]:ml-1 [&_small]:text-xs [&_small]:font-semibold [&_small]:tracking-normal [&_small]:text-mute';
const kpiS = 'mt-0.5 truncate text-xs text-mute [&_b]:font-semibold [&_b]:text-ink [&_b]:tabular-nums';
---

<Base title="Admin — hub" description="private" wide noindex>
  <div id="admin" data-endpoint={analytics.endpoint} data-client-id={admin.googleClientId} data-email={admin.email}>
    <div id="gate" class={`${card} mx-auto mt-[9vh] flex max-w-[460px] flex-col gap-5 px-6 py-6`}>
      <a class="flex min-w-0 items-center gap-2.5 text-ink [&>svg]:size-8" href="/" aria-label="hub 홈"><Mark uid="gate" /><span class="flex flex-col leading-tight"><b class="text-base">hub 관리</b><small class="text-xs text-mute">hub.seanson.com</small></span></a>
      <div class="flex items-start gap-3.5">
        <svg class="ico mt-0.5 size-[26px] text-mute" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
        <div>
          <strong class="text-[15px]">관리자 로그인</strong>
          <p class="mt-1 mb-3.5 text-[13px] text-mute">Google 계정으로 로그인하세요. 허용된 계정만 데이터를 볼 수 있어요.</p>
          <div id="g-btn" class="min-h-11"></div>
          <p id="gate-msg" class="note"></p>
        </div>
      </div>
    </div>

    <div id="panel" hidden>
      <aside class="adm-side fixed inset-y-0 left-0 z-20 flex w-[232px] flex-col gap-1 overflow-y-auto border-r border-line bg-card px-2.5 pt-4 pb-3 narrow:sticky narrow:top-0 narrow:bottom-auto narrow:w-auto narrow:flex-row narrow:flex-wrap narrow:items-center narrow:gap-x-2.5 narrow:gap-y-1 narrow:overflow-visible narrow:border-r-0 narrow:border-b narrow:px-3.5 narrow:pt-2.5 narrow:pb-0">
        <a class="flex min-w-0 items-center gap-2.5 px-2 pt-0.5 pb-4 text-ink [&>svg]:size-8 narrow:flex-1 narrow:p-0 narrow:[&>svg]:size-7" href="/" aria-label="hub 홈"><Mark uid="side" /><span class="flex min-w-0 flex-col leading-tight"><b class="text-base tracking-tight">hub 관리</b><small class="truncate text-xs text-mute narrow:hidden">접속자 · 운영 · 앱 관리</small></span></a>
        <nav class="adm-nav flex flex-col gap-0.5 narrow:order-3 narrow:-mx-3.5 narrow:w-[calc(100%+28px)] narrow:flex-row narrow:gap-1 narrow:overflow-x-auto narrow:px-3.5 narrow:pt-1.5 narrow:pb-2 narrow:[scrollbar-width:none]" aria-label="메뉴">
          {NAV_VIEWS.map(([v, name, d]) => <a href={`#${v}`} data-view={v} class={navA}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={d} />{name}</a>)}
          <span class="px-2.5 pt-3.5 pb-1 text-[11px] font-semibold tracking-wide text-mute narrow:hidden">앱 관리</span>
          {NAV_APPS.map(([app, name, d]) => <a href={appHref(app)} data-app={app} class={navA}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={d} />{name}</a>)}
        </nav>
        <div class="mt-auto flex min-w-0 items-center gap-2 border-t border-line px-2 pt-3 pb-0.5 text-xs text-mute narrow:m-0 narrow:max-w-[55%] narrow:flex-none narrow:border-0 narrow:p-0" id="who" hidden>
          <img id="who-pic" class="flex-none rounded-full phone:hidden" alt="" width="28" height="28" referrerpolicy="no-referrer" hidden />
          <span id="who-email" class="min-w-0 flex-1 truncate phone:hidden"></span>
          <button id="logout" class="ghost" type="button">로그아웃</button>
        </div>
      </aside>

      <div class="adm-main ml-[232px] px-8 pt-[22px] pb-14 narrow:ml-0 narrow:px-3.5 narrow:pt-4 narrow:pb-10"><div class="mx-auto max-w-[1240px]">
      <div class="adm-view" data-view="visitors">
        <div class={viewHead}><h2>접속자</h2><span id="asof" class="font-mono text-xs text-mute"></span></div>
        <p class={viewLead}>hub.seanson.com 방문 통계예요. 쿠키 없이 페이지 보기와 외부 링크 누름만 셉니다.</p>
        <div class={`${card} mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 px-3 py-2`}>
          <div class="seg" id="days" role="group" aria-label="기간">
            <button type="button" data-d="1">오늘</button>
            <button type="button" data-d="7" class="on">7일</button>
            <button type="button" data-d="30">30일</button>
            <button type="button" data-d="90">90일</button>
          </div>
          <button id="reload" class="icon-btn inline-grid size-8 place-items-center rounded-ctl border border-line bg-card text-ink transition-colors hover:bg-hov" type="button" title="새로고침" aria-label="새로고침">
            <svg class="ico size-4 [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66" /><path d="M20 4v5h-5" /></svg>
          </button>
          <span id="status" class="status"></span>
          <div class="ml-auto flex gap-4 tight:ml-0 tight:w-full">
            <label class="sw"><input id="auto" type="checkbox" checked /><span aria-hidden="true"></span>60초 자동</label>
            <label class="sw"><input id="notrack" type="checkbox" /><span aria-hidden="true"></span>내 방문 제외</label>
          </div>
        </div>
        <section id="vis-body" hidden>
        <div class="grid grid-cols-4 gap-3 tight:grid-cols-2 phone:gap-2">
          <div class={`${kpi} live [&.on]:border-ok/40 [&.on]:bg-ok/5`}>
            <div class={kpiL}><span class="pulse" aria-hidden="true"></span>실시간 · 5분</div>
            <div class={kpiN} id="k-live">–</div>
            <div class={kpiS} id="live-pages"></div>
          </div>
          <div class={kpi}>
            <div class={kpiL}>오늘</div>
            <div class={kpiN}><span id="k-tpv">–</span><small>PV</small></div>
            <div class={kpiS}>방문자 <b id="k-tuv">–</b></div>
          </div>
          <div class={kpi}>
            <div class={kpiL}>최근 <span id="k-rl">7일</span></div>
            <div class={kpiN}><span id="k-rpv">–</span><small>PV</small></div>
            <div class={kpiS}>방문자 <b id="k-ruv">–</b></div>
          </div>
          <div class={kpi}>
            <div class={kpiL}>외부 클릭</div>
            <div class={kpiN}><span id="k-clk">–</span></div>
            <div class={kpiS}>봇 제외 <b id="k-bot">–</b></div>
          </div>
        </div>

        <div class={box}>
          <div class={boxHead}>
            <h3>일별 추이</h3>
            <span class="legend"><i class="lg pv"></i>PV <i class="lg uv"></i>방문자</span>
          </div>
          <div class="chart">
            <span class="ymax mono" id="ymax"></span>
            <div id="daily" class="bars"></div>
          </div>
          <div id="xaxis" class="xaxis mono"></div>
        </div>

        <div class="grid grid-cols-2 gap-x-3.5 gap-y-0 tight:grid-cols-1">
          <div class={box}><div class={boxHead}><h3>페이지</h3><span>PV / 방문자</span></div><ul class="rank" id="pages"></ul></div>
          <div class={box}><div class={boxHead}><h3>유입 경로</h3></div><ul class="rank" id="refs"></ul></div>
          <div class={box}><div class={boxHead}><h3>외부 클릭</h3></div><ul class="rank" id="clicks"></ul></div>
          <div class={box}>
            <div class={boxHead}><h3>디바이스 · 언어</h3></div>
            <div id="devices" class="split"></div>
            <p id="devices-legend" class="dev-legend"></p>
            <ul class="rank" id="langs"></ul>
          </div>
        </div>

        <div class={box}>
          <div class={boxHead}><h3>시간대</h3><span>KST · 진할수록 많음</span></div>
          <div id="hours" class="heat"></div>
          <div class="heat-x mono"><span>0</span><span>6</span><span>12</span><span>18</span><span>23</span></div>
        </div>

        <div class={box}>
          <div class={boxHead}><h3>최근 방문</h3><span>최대 30건</span></div>
          <ul class="recent" id="recent"></ul>
        </div>
      </section>

      <section id="ops" class="mt-7">
        <div class={boxHead}><h3>운영 상태</h3><span>GitHub Actions 마지막 실행</span></div>
        <div class="tiles" id="ops-list"><div class="tile"><div class="tk">GitHub API 조회 중…</div></div></div>
      </section>
      </div>

      <section id="others" class="adm-view" data-view="apps">
        <div class={`apps-head ${viewHead}`}>
          <h2 id="app-title">앱 관리</h2>
          <span id="sc-status" class="status"></span>
          <a id="sc-open" class="ml-auto text-[12.5px] whitespace-nowrap text-mute hover:text-ink" href="#" target="_blank" rel="noopener">새 창에서 열기 ↗</a>
        </div>
        <p class={viewLead} id="app-lead"></p>
        <!-- 오룬카: 맨 위 막대(되돌아가기 · 관리 도구 | 실서버·게시판 · 새 창) — 막대 아래 화면 전체가 7800 관리 도구 -->
        <div id="ok-bar" class="fixed inset-x-0 top-0 z-30 flex h-12 items-center gap-2.5 border-b border-line bg-card px-3 shadow-card phone:gap-1.5 phone:px-2" hidden>
          <button id="ok-back" class="ghost py-1.5! font-medium" type="button"><svg class="ico size-4 [stroke-width:2.2]" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>되돌아가기</button>
          <b class="flex items-center gap-1.5 text-[14px] narrow:hidden"><svg class="ico size-[18px] text-brand" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="7" width="19" height="11" rx="4" /><path d="M7 12.5h4M9 10.5v4M15.5 11.5h.01M18 13.5h.01" /></svg>오룬카 관리</b>
          <div class="seg" id="ok-seg" role="group" aria-label="보기">
            <button type="button" data-s="tool" class="on">관리 도구</button>
            <button type="button" data-s="hub"><span class="phone:hidden">실서버 저장 · 게시판</span><span class="hidden phone:inline">실서버</span></button>
          </div>
          <span class="min-w-0 flex-1 truncate"><span id="ok-st" class="status"></span></span>
          <a id="ok-open" class="text-[12.5px] whitespace-nowrap text-mute hover:text-ink" href="#" target="_blank" rel="noopener">새 창 ↗</a>
        </div>
        <div id="ok-off" class={`${card} mx-auto mt-6 max-w-[560px] px-6 py-6`}>
          <div class="flex items-start gap-3.5">
            <svg class="ico mt-0.5 size-[26px] text-mute" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            <div class="min-w-0">
              <strong class="text-[15px]">오룬카 관리 도구는 이 맥에서만 열려요</strong>
              <p id="ok-off-msg" class="mt-1 mb-4 text-[13px] break-words text-mute"></p>
              <div class="flex flex-wrap gap-2">
                <button id="ok-retry" class="ghost" type="button">다시 시도</button>
                <button id="ok-tohub" class="ghost" type="button">실서버 저장 · 게시판 보기</button>
              </div>
            </div>
          </div>
        </div>
        <details class="conn mb-3 text-[13px]" id="sc-conn">
          <summary class="w-fit cursor-pointer text-mute">연결 설정</summary>
          <div class="mt-2 flex max-w-[520px] gap-2">
            <input id="sc-url" class="min-w-0 flex-1 rounded-ctl border border-line bg-card px-2.5 py-1.5 font-mono text-[13px] text-ink" type="text" placeholder="http://127.0.0.1:8500" spellcheck="false" aria-label="SeanChat admin URL" />
            <button id="sc-save" class="ghost" type="button">저장</button>
          </div>
          <p class="note mt-2 text-xs" id="sc-note">SeanChat 통합 관리자(로컬 8500, 작심·만수르 Firestore 포함)를 아래에 띄웁니다. 공개 EC2에는 관리 화면이 없어서(의도) 로컬 백엔드가 켜진 이 Mac에서만 보입니다. SSM 터널을 쓰면 8600으로 바꾸세요.</p>
        </details>
        <div id="og-panel" hidden></div>
        <div id="ob-panel" hidden></div>
        <details id="oc-old" class="oc-old" hidden><summary>옛 서버 저장(Firestore) — 게임 서버로 옮기기 전 판</summary><div id="oc-panel"></div></details>
        <iframe id="sc-frame" title="SeanChat admin" allow="local-network-access; clipboard-write" hidden></iframe>
        <div id="kt-panel" hidden></div>
        <div id="ar-panel" hidden></div>
        <div id="rl-panel" hidden></div>
      </section>
      </div></div>
    </div>
  </div>
  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
</Base>

<!-- is:global (every rule prefixed with #admin): most of this page is rendered via innerHTML,
     and Astro's scoped attributes don't reach injected nodes — that's why the daily bars and
     the heatmap used to render invisible. -->
<style is:global>
  /* 판 틀·색·공통 조작부(.ghost .seg .sw .status)·카드 = src/styles/admin.css(Tailwind) — 아래는 innerHTML 로 그리는 것만 */
  #admin { --uv: var(--fg); }

  /* daily chart */
  #admin .legend { font-size: .75rem; color: var(--muted); display: inline-flex; align-items: center; gap: .35rem; }
  #admin .lg { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-left: .35rem; }
  #admin .lg.pv, #admin .bars .b i { background: color-mix(in srgb, var(--accent) 38%, var(--card)); }
  #admin .lg.uv, #admin .bars .b u { background: var(--accent); }
  #admin .chart { position: relative; height: 150px; border-bottom: 1px solid var(--line);
    background: repeating-linear-gradient(to top, transparent 0 calc(25% - 1px), color-mix(in srgb, var(--line) 70%, transparent) calc(25% - 1px) 25%); }
  #admin .chart { margin-top: 1.1rem; }
  /* y-max label sits just above the top gridline (never over a full-height bar) */
  #admin .ymax { position: absolute; bottom: calc(100% + 2px); left: 0; font-size: .68rem; line-height: 1; color: var(--muted); }
  #admin .bars { position: absolute; inset: 0; display: flex; align-items: stretch; gap: 3px; }
  #admin .bars .b { flex: 1 1 0; position: relative; min-width: 2px; }
  #admin .bars .b i, #admin .bars .b u { position: absolute; bottom: 0; left: 0; right: 0; border-radius: 3px 3px 0 0; min-height: 0; }
  #admin .bars .b u { left: 22%; right: 22%; }
  #admin .bars .b:hover i { filter: brightness(.92); }
  #admin .bars .b:hover::after { content: attr(data-t); position: absolute; bottom: calc(100% + 4px); left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); font-size: .72rem; padding: .15rem .45rem; border-radius: 5px; white-space: nowrap; z-index: 3; pointer-events: none; }
  #admin .bars .b:first-child:hover::after { left: 0; transform: none; }
  #admin .bars .b:last-child:hover::after { left: auto; right: 0; transform: none; }
  #admin .xaxis { display: flex; justify-content: space-between; font-size: .68rem; color: var(--muted); margin-top: .35rem; }

  /* ranked lists (bar behind the row) */
  #admin .adm-grid { display: grid; gap: 0 .85rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #admin .rank { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: .86rem; }
  #admin .rank li { position: relative; display: flex; justify-content: space-between; gap: .75rem; padding: .28rem .5rem; border-radius: 6px; overflow: hidden; }
  #admin .rank li > i { position: absolute; inset: 0 auto 0 0; background: color-mix(in srgb, var(--accent) 16%, transparent); border-radius: 6px; z-index: 0; }
  #admin .rank li > span { position: relative; z-index: 1; min-width: 0; }
  #admin .rank .k { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #admin .rank .v { font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 600; }
  #admin .rank .v .muted { font-weight: 400; }
  #admin .rank li.empty { color: var(--muted); }
  #admin .split { display: flex; height: 8px; border-radius: 4px; overflow: hidden; background: var(--line); gap: 2px; }
  #admin .split i { display: block; height: 100%; }
  #admin .split i.m { background: var(--spec); }
  #admin .split i.d { background: var(--pro); }
  #admin .dev-legend { display: flex; gap: 1rem; font-size: .8rem; color: var(--muted); margin: .45rem 0 .7rem; }
  #admin .dev-legend span { display: inline-flex; align-items: center; gap: .3rem; }
  #admin .dev-legend b { color: var(--fg); font-variant-numeric: tabular-nums; }
  #admin .dev-legend .dm { color: var(--spec); } #admin .dev-legend .dd { color: var(--pro); }

  /* hours heatmap */
  #admin .heat { display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: 3px; }
  #admin .heat div { height: 28px; border-radius: 4px; background: var(--line); }
  #admin .heat-x { display: flex; justify-content: space-between; font-size: .68rem; color: var(--muted); margin-top: .35rem; }

  /* recent */
  #admin .recent { list-style: none; margin: 0; padding: 0; font-size: .85rem; }
  #admin .recent li { display: grid; grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 11rem) 1.2rem; gap: .75rem; align-items: center; padding: .38rem 0; border-top: 1px solid var(--line); }
  #admin .recent li:first-child { border-top: 0; }
  #admin .recent .t { color: var(--muted); font-size: .78rem; }
  #admin .recent .p, #admin .recent .r { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #admin .recent .r { color: var(--muted); }
  #admin .recent svg, #admin .dev-legend svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #admin .recent svg { color: var(--muted); }

  /* ops tiles */
  #admin .tiles { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  #admin .tile { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: .8rem .95rem; min-width: 0; }
  #admin .tile .tk { display: flex; align-items: center; gap: .45rem; font-size: .78rem; color: var(--muted); font-weight: 500; }
  #admin .tile .tk::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--line); flex: none; }
  #admin .tile.ok .tk::before { background: var(--ok); }
  #admin .tile.warn .tk::before { background: var(--warn); }
  #admin .tile.bad .tk::before { background: var(--bad); }
  #admin .tile .tv { font-weight: 600; margin-top: .3rem; font-size: .95rem; overflow-wrap: anywhere; }
  #admin .tile.bad .tv { color: var(--bad); }
  #admin .tile .ts { font-size: .78rem; color: var(--muted); margin-top: .1rem; overflow-wrap: anywhere; }

  @media (max-width: 760px) {
    #admin .recent li { grid-template-columns: 6rem minmax(0, 1fr) 1.1rem; }
    #admin .recent .r { display: none; }
  }
  @media (max-width: 560px) {
    #admin .heat div { height: 22px; }
    #admin .heat { gap: 2px; }
  }
</style>

<script>
  import { mountKnowThat } from '../../lib/knowthat-ui';
  import { clearFirebaseToken } from '../../lib/knowthat-core';
  import { mountOrunkaCloud } from '../../lib/orunka-cloud';
  import { mountOrunkaGameSaves } from '../../lib/orunka-game-saves';
  import { mountOrunkaBoardViews } from '../../lib/orunka-board-views';
  import { mountAgentRoom } from '../../lib/agentroom-view';
  import { mountRoomHistory } from '../../lib/agentroom-history';
  // ---- helpers -----------------------------------------------------------------
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const root = $('admin');
  const ENDPOINT = root.dataset.endpoint!;
  const LS_NOTRACK = 'hub.notrack';
  const LS_SC = 'hub.admin.scUrl';
  const LS_APP = 'hub.admin.app';
  // 왼쪽 메뉴 앱 = [화면 제목, 한 줄 설명]
  const APP_INFO: Record<string, [string, string]> = {
    seanchat: ['SeanChat', '로컬 SeanChat 백엔드(이 Mac)의 통합 관리 화면을 아래에 띄웁니다.'],
    jaksim: ['작심', 'SeanChat 통합 관리 화면의 작심 칸(Firestore)을 띄웁니다. 이 Mac 에서만 보여요.'],
    mansur: ['만수르', 'SeanChat 통합 관리 화면의 만수르 칸(Firestore)을 띄웁니다. 이 Mac 에서만 보여요.'],
    knowthat: ['너그거알아', '브라우저에서 바로 Firestore(knowthat-app)를 보고 고칩니다.'],
    orunka: ['오룬카', '집 Mac 의 오룬카 관리 도구(7800)를 화면 전체에 띄웁니다. 실서버 저장·게시판 조회 수는 위 막대에서 바꿔 봐요.'],
    room: ['에이전트 방', '관문 방 대화를 실시간으로 보고 Sean 으로 씁니다. 최근 30분 글만 보여요 — 전체 글은 「방 기록」.'],
    roomlog: ['방 기록', '관문 방에 남은 전체 글을 날짜별로 봅니다. 보기 전용 — 위로 올리면 이전 글을 더 받고, 새 글은 새로고침으로 받아요.'],
  };
  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const fmt = (n: number) => n.toLocaleString('ko-KR');
  const ICON = {
    m: '<svg viewBox="0 0 24 24" aria-label="모바일"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>',
    d: '<svg viewBox="0 0 24 24" aria-label="데스크톱"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
  };
  // ranked list: the row itself is the bar (width ∝ share of the top item)
  const rows = (id: string, items: { k: string; n: number; uv?: number }[], link = false) => {
    const max = Math.max(1, ...items.map((i) => i.n));
    $(id).innerHTML = items.length
      ? items
          .map((i) => {
            const label = link
              ? `<a href="${esc(i.k)}" target="_blank" rel="noopener" title="${esc(i.k)}">${esc(i.k.replace(/^https?:\/\//, ''))}</a>`
              : `<span title="${esc(i.k)}">${esc(i.k)}</span>`;
            return (
              `<li><i style="width:${((i.n / max) * 100).toFixed(1)}%"></i><span class="k">${label}</span>` +
              `<span class="v">${fmt(i.n)}${i.uv != null ? ` <span class="muted">/ ${fmt(i.uv)}</span>` : ''}</span></li>`
            );
          })
          .join('')
      : '<li class="empty"><span>아직 없음</span></li>';
  };
  const setStatus = (msg: string, cls = '') => {
    const el = $('status');
    el.textContent = msg;
    el.className = 'status ' + cls;
  };

  // ---- Google sign-in (GIS) ---------------------------------------------------------
  // The ID token is the bearer for /stats. It lives 1 h; when it's about to expire we
  // ask GIS again (auto_select → silent for the one previously-consented account).
  const CLIENT_ID = root.dataset.clientId!;
  const ADMIN_EMAIL = (root.dataset.email || '').toLowerCase();
  const LS_ID = 'hub.admin.idtoken';
  // layout preview on a dev server only (`/admin/?demo`): synthetic numbers, no auth, no API
  // call — the live API's CORS allows only the hub origin, so localhost can't fetch real stats.
  const DEMO = /^(localhost|127\.0\.0\.1)$/.test(location.hostname) && new URLSearchParams(location.search).has('demo');
  function demoStats(days: number) {
    const r = (a: number, b: number) => a + Math.floor(Math.random() * (b - a + 1));
    const now = new Date(Date.now() + 9 * 36e5);
    const daily = Array.from({ length: days }, (_, i) => {
      const d = new Date(now.getTime() - (days - 1 - i) * 864e5);
      const pv = r(2, 40);
      return { date: d.toISOString().slice(0, 10), pv, uv: Math.max(1, Math.round(pv * (0.45 + Math.random() * 0.4))) };
    });
    const pv = daily.reduce((a, d) => a + d.pv, 0);
    const pages = ['/', '/retire/', '/admin/'].map((k, i) => ({ k, n: Math.round(pv / (i + 1.4)), uv: Math.round(pv / (i + 2.2)) }));
    return {
      days, now: now.toISOString(),
      live: { visitors: 2, pages: [{ k: '/', n: 1 }, { k: '/retire/', n: 1 }] },
      today: { pv: daily[days - 1].pv, uv: daily[days - 1].uv },
      range: { pv, uv: daily.reduce((a, d) => a + d.uv, 0), clicks: r(3, 30), bots: r(0, 20) },
      daily, pages,
      referrers: [{ k: 'direct', n: r(20, 60) }, { k: 'velog.io', n: r(5, 20) }, { k: 'google.com', n: r(1, 10) }, { k: 'github.com', n: r(1, 5) }],
      clicks: [{ k: 'https://apps.apple.com/kr/app/id6804211842', n: r(3, 9) }, { k: 'https://velog.io/@seanson2709', n: r(1, 5) }],
      langs: [{ k: 'ko', n: r(20, 50) }, { k: 'en', n: r(5, 20) }, { k: 'ja', n: r(0, 4) }],
      devices: { m: r(10, 40), d: r(10, 40) },
      hours: Array.from({ length: 24 }, (_, h) => (h > 8 && h < 24 ? r(0, 12) : r(0, 2))),
      recent: Array.from({ length: 12 }, (_, i) => ({
        ts: Date.now() - i * r(4, 90) * 6e4, p: pages[i % 3].k,
        r: ['direct', 'velog.io', 'google.com', 'https://a-very-long-referrer.example.com/some/deep/path'][i % 4], d: i % 3 ? 'd' : 'm',
      })),
    };
  }
  localStorage.removeItem('hub.admin.token'); // retired static admin token — purge old copies
  type Claims = { email?: string; exp?: number; picture?: string };
  const claims = (jwt: string | null): Claims | null => {
    try {
      const p = jwt!.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      return JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(p), (c) => c.charCodeAt(0))));
    } catch {
      return null;
    }
  };
  const fresh = (c: Claims | null, marginS = 90) => !!c?.exp && c.exp * 1000 - Date.now() > marginS * 1000;
  const idToken = () => {
    const t = localStorage.getItem(LS_ID);
    return fresh(claims(t)) ? t : null;
  };
  const gateMsg = (msg: string, err = false) => {
    const el = $('gate-msg');
    el.textContent = msg;
    el.className = 'note' + (err ? ' err' : '');
  };
  let gisReady = false;
  function gis(cb: () => void) {
    const g = (window as any).google?.accounts?.id;
    if (g) {
      if (!gisReady) {
        g.initialize({
          client_id: CLIENT_ID,
          callback: onCredential,
          auto_select: true,
          cancel_on_tap_outside: false,
          use_fedcm_for_prompt: true,
          itp_support: true,
          context: 'signin',
        });
        g.renderButton($('g-btn'), { theme: 'outline', size: 'large', text: 'signin_with', shape: 'pill', locale: 'ko' });
        gisReady = true;
      }
      return cb();
    }
    let n = 0;
    const iv = window.setInterval(() => {
      if ((window as any).google?.accounts?.id) {
        clearInterval(iv);
        gis(cb);
      } else if (++n > 100) {
        clearInterval(iv);
        gateMsg('Google 로그인 스크립트를 불러오지 못했습니다 (차단 확장 프로그램/네트워크 확인)', true);
      }
    }, 100);
  }
  function onCredential(resp: { credential: string }) {
    const c = claims(resp.credential);
    if ((c?.email || '').toLowerCase() !== ADMIN_EMAIL) {
      (window as any).google?.accounts?.id?.disableAutoSelect();
      return gateMsg(`${c?.email ?? '이 계정'} 은(는) 관리자 권한이 없습니다`, true);
    }
    localStorage.setItem(LS_ID, resp.credential);
    // the owner is here → stop counting their own visits unless they opted back in
    if (localStorage.getItem(LS_NOTRACK) === null) {
      localStorage.setItem(LS_NOTRACK, '1');
      notrackEl.checked = true;
    }
    signedIn();
  }
  function showGate(msg = '', err = false, keepPanel = false) {
    clearTimeout(timer);
    if (!keepPanel) $('panel').hidden = true;
    if (!keepPanel) $('who').hidden = true;
    $('gate').hidden = false;
    gateMsg(msg, err);
    gis(() => (window as any).google.accounts.id.prompt());
  }
  let booted = false;
  function signedIn() {
    const c = DEMO ? { email: ADMIN_EMAIL + ' (demo)' } : claims(idToken());
    $('gate').hidden = true;
    $('panel').hidden = false;
    $('who').hidden = false;
    $('who-email').textContent = c?.email ?? '';
    const pic = $('who-pic') as HTMLImageElement;
    if (c?.picture?.startsWith('https://')) {
      pic.src = c.picture;
      pic.hidden = false;
    }
    load();
    if (!booted) {
      booted = true;
      ops();
      setView(viewFromHash() || localStorage.getItem(LS_VIEW) || 'visitors');
    }
  }
  $('logout').addEventListener('click', () => {
    localStorage.removeItem(LS_ID);
    clearFirebaseToken();
    sessionStorage.removeItem('hub.admin.orunka.fbtoken');
    (window as any).google?.accounts?.id?.disableAutoSelect();
    showGate('로그아웃했습니다');
  });

  // ---- options -------------------------------------------------------------------
  const daysEl = $('days');
  let days = 7;
  daysEl.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
    b.addEventListener('click', () => {
      days = Number(b.dataset.d);
      daysEl.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      load();
    })
  );
  const autoEl = $('auto') as HTMLInputElement;
  const notrackEl = $('notrack') as HTMLInputElement;
  notrackEl.checked = localStorage.getItem(LS_NOTRACK) === '1';
  notrackEl.addEventListener('change', () => {
    if (notrackEl.checked) localStorage.setItem(LS_NOTRACK, '1');
    else localStorage.removeItem(LS_NOTRACK);
  });
  $('reload').addEventListener('click', () => load());
  autoEl.addEventListener('change', () => {
    clearTimeout(timer);
    if (autoEl.checked) timer = window.setTimeout(load, 60_000);
  });

  // ---- stats -------------------------------------------------------------------------
  let timer: number | undefined;
  async function load() {
    if (DEMO) {
      render(demoStats(days));
      setStatus('데모 데이터 · 갱신 ' + new Date().toLocaleTimeString('ko-KR'), 'ok');
      return;
    }
    const token = idToken();
    if (!token) {
      localStorage.removeItem(LS_ID);
      // keep the last numbers on screen while GIS silently re-issues a token (auto_select)
      return showGate('로그인이 만료되어 갱신 중… 안 되면 아래 버튼으로 다시 로그인하세요', false, booted);
    }
    setStatus('조회 중…');
    $('reload').classList.add('spin');
    let res: Response;
    try {
      res = await fetch(`${ENDPOINT}/stats?days=${days}`, {
        headers: { Authorization: `Bearer ${token}` },
        cache: 'no-store',
      });
    } catch (e) {
      const local = /^(localhost|127\.0\.0\.1)$/.test(location.hostname);
      return setStatus(local ? '로컬에서는 API CORS가 hub 도메인만 허용해서 통계를 못 불러와요 (정상). ?demo 로 레이아웃 확인' : '네트워크 오류: ' + (e as Error).message, 'err');
    } finally {
      $('reload').classList.remove('spin');
    }
    if (res.status === 401 || res.status === 403) {
      localStorage.removeItem(LS_ID);
      $('vis-body').hidden = true;
      return showGate(`서버가 로그인을 거부했습니다 (${res.status}) — 다시 로그인하세요`, true);
    }
    if (!res.ok) return setStatus(`오류 ${res.status}`, 'err');
    render(await res.json());
    setStatus('갱신 ' + new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit' }), 'ok');
    clearTimeout(timer);
    if (autoEl.checked) timer = window.setTimeout(load, 60_000);
  }

  function render(s: any) {
    $('vis-body').hidden = false;
    $('asof').textContent = `KST ${s.now.slice(0, 16).replace('T', ' ')}`;
    $('k-live').textContent = fmt(s.live.visitors);
    document.querySelector('#admin .kpi.live')!.classList.toggle('on', s.live.visitors > 0);
    $('k-tpv').textContent = fmt(s.today.pv);
    $('k-tuv').textContent = fmt(s.today.uv);
    $('k-rl').textContent = s.days === 1 ? '1일' : `${s.days}일`;
    $('k-rpv').textContent = fmt(s.range.pv);
    $('k-ruv').textContent = fmt(s.range.uv);
    $('k-clk').textContent = fmt(s.range.clicks);
    $('k-bot').textContent = fmt(s.range.bots);
    $('live-pages').innerHTML = s.live.pages.length
      ? s.live.pages.map((p: any) => `<code>${esc(p.k)}</code> ×${p.n}`).join(' · ')
      : '지금 접속자 없음';

    // daily: wide pale bar = PV, narrow solid bar = UV (overlaid, same scale)
    const dmax = Math.max(1, ...s.daily.map((d: any) => d.pv));
    const pct = (n: number) => `${((n / dmax) * 100).toFixed(1)}%`;
    $('ymax').textContent = fmt(dmax);
    $('daily').innerHTML = s.daily
      .map(
        (d: any) =>
          `<div class="b" data-t="${esc(d.date.slice(5))} · PV ${d.pv} · 방문자 ${d.uv}">` +
          `<i style="height:${pct(d.pv)}"></i><u style="height:${pct(d.uv)}"></u></div>`
      )
      .join('');
    const ds: string[] = s.daily.map((d: any) => String(d.date).slice(5).replace('-', '.'));
    const ticks = ds.length <= 1 ? ds : [ds[0], ds[Math.floor((ds.length - 1) / 2)], ds[ds.length - 1]];
    $('xaxis').innerHTML = ticks.map((t) => `<span>${esc(t)}</span>`).join('');

    rows('pages', s.pages);
    rows('refs', s.referrers);
    rows('clicks', s.clicks, true);
    rows('langs', s.langs);
    const tot = s.devices.m + s.devices.d;
    const share = (n: number) => (tot ? Math.round((n / tot) * 100) : 0);
    $('devices').innerHTML = tot
      ? `<i class="m" style="width:${(s.devices.m / tot) * 100}%"></i><i class="d" style="width:${(s.devices.d / tot) * 100}%"></i>`
      : '';
    $('devices-legend').innerHTML =
      `<span class="dm">${ICON.m}</span><span>모바일 <b>${fmt(s.devices.m)}</b> · ${share(s.devices.m)}%</span>` +
      `<span class="dd">${ICON.d}</span><span>데스크톱 <b>${fmt(s.devices.d)}</b> · ${share(s.devices.d)}%</span>`;

    const hmax = Math.max(1, ...s.hours);
    $('hours').innerHTML = s.hours
      .map((h: number, i: number) => {
        const bg = h ? `color-mix(in srgb, var(--accent) ${Math.round(18 + (h / hmax) * 82)}%, var(--line))` : '';
        return `<div title="${i}시 · ${h}"${bg ? ` style="background:${bg}"` : ''}></div>`;
      })
      .join('');

    const hhmm = (ts: number | string) => {
      const d = new Date(new Date(ts).getTime() + 9 * 36e5); // KST regardless of the viewer's TZ
      const p = (n: number) => String(n).padStart(2, '0');
      return `${p(d.getUTCMonth() + 1)}.${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())}`;
    };
    $('recent').innerHTML = s.recent.length
      ? s.recent
          .map(
            (e: any) =>
              `<li><span class="t mono">${hhmm(e.ts)}</span>` +
              `<span class="p" title="${esc(e.p)}">${esc(e.p)}</span><span class="r" title="${esc(e.r)}">${esc(e.r)}</span>${e.d === 'm' ? ICON.m : ICON.d}</li>`
          )
          .join('')
      : '<li class="muted">아직 없음</li>';
  }

  // ---- ops: GitHub Actions (public repo → unauthenticated API) ----
  async function ops() {
    const items: string[] = [];
    // v/sub are pre-escaped HTML
    const tile = (k: string, v: string, sub = '', cls = '') =>
      items.push(`<div class="tile ${cls}"><div class="tk">${esc(k)}</div><div class="tv">${v}</div>${sub ? `<div class="ts">${sub}</div>` : ''}</div>`);
    const ago = (iso: string) => {
      const h = (Date.now() - new Date(iso).getTime()) / 36e5;
      return h < 1 ? `${Math.round(h * 60)}분 전` : h < 48 ? `${Math.round(h)}시간 전` : `${Math.round(h / 24)}일 전`;
    };
    for (const [name, wf] of [
      ['Pages 배포', 'pages.yml'],
    ]) {
      try {
        const r = await fetch(`https://api.github.com/repos/Sean2709/hub/actions/workflows/${wf}/runs?per_page=1`, {
          headers: { Accept: 'application/vnd.github+json' },
        });
        if (!r.ok) throw new Error(String(r.status));
        const run = (await r.json()).workflow_runs?.[0];
        if (!run) throw new Error('no runs');
        const good = run.conclusion === 'success';
        tile(
          name,
          `<a href="${esc(run.html_url)}" target="_blank" rel="noopener">${esc(run.conclusion || run.status)} ↗</a>`,
          `${esc(ago(run.updated_at))} · ${esc(run.event)}`,
          good ? 'ok' : run.conclusion ? 'bad' : 'warn'
        );
      } catch (e) {
        tile(name, '조회 실패', esc((e as Error).message), 'warn');
      }
    }
    $('ops-list').innerHTML = items.join('');
  }

  // ---- other admins (SeanChat unified admin: 션챗 · 작심 · 만수르) ------------------
  const scUrlEl = $('sc-url') as HTMLInputElement;
  const frame = $('sc-frame') as HTMLIFrameElement;
  // 오룬카(게임) = OrunkaUnity 레포. 온라인 실서버(game.orunka.com, 2026-10-06~)가 저장 정본이고 위 패널이 그 /admin/api 를 씀.
  // 아래 iframe = 같은 Mac의 로컬 관리 도구 OrunkaUnity/tools/admin/serve.py (launchd com.sean.orunka, 127.0.0.1:7800 —
  // 옛 TS판 Node 서버와 같은 주소라 저장된 orunkaUrl을 그대로 쓴다). 개요·출시 판·사용자·저장 고치기·자료·매뉴얼.
  // 고치기 POST는 x-orunka-admin 헤더 필요(ORUNKA_ADMIN_KEY를 설정했을 때만 값 검사).
  const LS_DB = 'hub.admin.orunkaUrl';
  // 옛 게임(오르마·돌바람, StoneAge 레포 7700)은 폐기됨 — 저장된 주소는 7700을 가리키므로 옮기지 않고 지운다
  ['hub.admin.ormaUrl', 'hub.admin.dolbaramUrl'].forEach((k) => localStorage.removeItem(k));
  if (['orma', 'dolbaram'].includes(localStorage.getItem(LS_APP) || '')) localStorage.setItem(LS_APP, 'orunka');
  const DB_DEFAULT = 'http://127.0.0.1:7800';
  const SC_NOTE = $('sc-note').textContent || '';
  const DB_NOTE = '「실서버 저장 · 게시판」 = 실서버 저장(정본)과 orunka.com 게시판 조회 수예요. 줄을 누르면 그 사용자 편집기(JSON·라이·백업)가 열리고, 관리 도구도 그 사용자로 맞춰집니다. 「관리 도구」 = 집 Mac 의 launchd 상시 도구(기본 7800): 개요, 출시, 사용자와 저장 고치기, 게임 자료, 구성, 실서버, 매뉴얼. 루프백 주소라 그 Mac 에서만 보여요. 꺼져 있으면 OrunkaUnity 에서 bash tools/admin/agent.sh install.';
  const isDb = (app: string) => app === 'orunka';
  const scBase = () => (localStorage.getItem(LS_SC) || 'http://127.0.0.1:8500').replace(/\/+$/, '');
  const dbBase = () => (localStorage.getItem(LS_DB) || DB_DEFAULT).replace(/\/+$/, '');
  const baseFor = (app: string) => (isDb(app) ? dbBase() : scBase());
  scUrlEl.value = scBase();
  $('sc-save').addEventListener('click', () => {
    const app = localStorage.getItem(LS_APP) || 'seanchat';
    localStorage.setItem(isDb(app) ? LS_DB : LS_SC, scUrlEl.value.trim().replace(/\/+$/, ''));
    showApp(app);
  });
  // 너그거알아는 로컬 백엔드 없이 브라우저 → Firestore(knowthat-app) 직접 편집 (lib/knowthat-ui.ts)
  const ktPanel = $('kt-panel');
  let kt: ReturnType<typeof mountKnowThat> | null = null;
  // 오룬카 서버 저장(Firebase orunka-game) — 로컬 관리 도구 iframe 위에, 어느 기기에서나 (lib/orunka-cloud.ts)
  const ocPanel = $('oc-panel');
  let oc: ReturnType<typeof mountOrunkaCloud> | null = null;
  // 게임 서버 저장(정본, D57 — 혼자 하기 없음) — game.seanson.com /admin/api/saves (lib/orunka-game-saves.ts)
  const ogPanel = $('og-panel');
  const ocOld = $('oc-old');
  let og: ReturnType<typeof mountOrunkaGameSaves> | null = null;
  // orunka.com 게시판 조회 묶음 통계(게시판 API v4 GET /api/admin/views) — 같은 Firebase 토큰 (lib/orunka-board-views.ts)
  const obPanel = $('ob-panel');
  let ob: ReturnType<typeof mountOrunkaBoardViews> | null = null;
  // 에이전트 방 대화 보기(읽기 전용) — 관문 mcp.seanson.com /api/room/* long-poll (lib/agentroom-view.ts)
  const arPanel = $('ar-panel');
  let ar: ReturnType<typeof mountAgentRoom> | null = null;
  // 방 기록(전체 글, 보기 전용) — 관문 /api/room/history (lib/agentroom-history.ts)
  const rlPanel = $('rl-panel');
  let rl: ReturnType<typeof mountRoomHistory> | null = null;
  // 오룬카 = 화면 전체(#admin.full)에 로컬 관리 도구(7800) + 맨 위 막대. data-seg = tool(관리 도구) | hub(실서버 저장·게시판, 어느 기기에서나)
  let okSeg: 'tool' | 'hub' = 'tool';
  let prevView = 'visitors';
  function setOkSeg(s: 'tool' | 'hub') {
    okSeg = s;
    root.dataset.seg = s;
    $('ok-seg').querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.classList.toggle('on', b.dataset.s === s));
    const hub = root.classList.contains('full') && s === 'hub';
    ogPanel.hidden = obPanel.hidden = ocOld.hidden = !hub;
    window.scrollTo(0, 0);
  }
  function setFull(on: boolean) {
    root.classList.toggle('full', on);
    $('ok-bar').hidden = !on;
    if (!on) root.classList.remove('ok-off');
    root.dataset.seg = okSeg;
  }
  $('ok-seg').querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => setOkSeg(b.dataset.s as 'tool' | 'hub')));
  $('ok-back').addEventListener('click', () => setView(prevView, true));
  $('ok-retry').addEventListener('click', () => showApp('orunka'));
  $('ok-tohub').addEventListener('click', () => setOkSeg('hub'));
  async function showApp(app: string) {
    localStorage.setItem(LS_APP, app);
    setFull(isDb(app));
    document.querySelectorAll<HTMLElement>('#admin .adm-nav [data-app]').forEach((b) => b.classList.toggle('on', b.dataset.app === app));
    const info = APP_INFO[app];
    if (info) {
      $('app-title').textContent = info[0];
      $('app-lead').textContent = info[1];
    }
    const isKt = app === 'knowthat';
    const isRoom = app === 'room';
    const isLog = app === 'roomlog';
    ktPanel.hidden = !isKt;
    arPanel.hidden = !isRoom;
    rlPanel.hidden = !isLog;
    if (isLog && !rl) {
      rl = mountRoomHistory(rlPanel, {
        idToken,
        demo: DEMO,
        onAuthFail: () => {
          localStorage.removeItem(LS_ID);
          showGate('로그인이 만료되어 갱신 중… 안 되면 아래 버튼으로 다시 로그인하세요', false, true);
        },
      });
    }
    rl?.setActive(isLog);
    if (isRoom && !ar) {
      ar = mountAgentRoom(arPanel, {
        idToken,
        demo: DEMO,
        onAuthFail: () => {
          localStorage.removeItem(LS_ID);
          showGate('로그인이 만료되어 갱신 중… 안 되면 아래 버튼으로 다시 로그인하세요', false, true);
        },
      });
    }
    ar?.setActive(isRoom);
    ogPanel.hidden = obPanel.hidden = ocOld.hidden = !(isDb(app) && okSeg === 'hub');
    if (isDb(app) && !ob) {
      ob = mountOrunkaBoardViews(obPanel, idToken);
      ob.load();
    }
    if (isDb(app) && !og) {
      // 줄을 열면 관리 도구(iframe)도 그 사용자(?target=game:h)로 — 펫·아이템·회복 단추 편집기(집 Mac에서 도구가 켜져 있을 때만)
      og = mountOrunkaGameSaves(ogPanel, idToken, undefined, (h, jump) => {
        if (frame.hidden || !frame.src) return jump ? '오룬카 관리 도구가 연결돼 있지 않아요(집 Mac 에서 켜져 있을 때만) — 위 JSON 편집기로 고치세요' : '';
        const url = `${dbBase()}/admin?target=${encodeURIComponent('game:' + h)}#save`;
        if (frame.src !== url) frame.src = url;
        if (jump) setOkSeg('tool');
        return '';
      });
      og.load();
    }
    if (isDb(app) && !oc) {
      // 줄을 누르면 관리 도구(iframe)도 그 사용자로 — 펫·아이템·회복 단추 편집기(집 Mac에서 도구가 켜져 있을 때만)
      oc = mountOrunkaCloud(ocPanel, idToken, (uid, jump) => {
        if (frame.hidden || !frame.src) return jump ? '오룬카 관리 도구가 연결돼 있지 않아요(집 Mac 에서 켜져 있을 때만) — 위 JSON 편집기로 고치세요' : '';
        const url = `${dbBase()}/admin?target=${encodeURIComponent('cloud:' + uid)}#save`;
        if (frame.src !== url) frame.src = url;
        if (jump) setOkSeg('tool');
        return '';
      });
      oc.load();
    }
    $('sc-conn').hidden = isKt || isRoom || isLog;
    $('sc-open').hidden = isKt || isRoom || isLog;
    if (isKt || isRoom || isLog) {
      frame.hidden = true;
      $('sc-status').textContent = '';
      if (isKt && !kt) {
        kt = mountKnowThat(ktPanel, idToken);
        kt.load();
      }
      return;
    }
    const base = baseFor(app);
    const label = isDb(app) ? '오룬카 관리 도구' : '로컬 SeanChat 백엔드';
    scUrlEl.value = base;
    scUrlEl.placeholder = isDb(app) ? DB_DEFAULT : 'http://127.0.0.1:8500';
    $('sc-note').textContent = isDb(app) ? DB_NOTE : SC_NOTE;
    frame.title = isDb(app) ? '오룬카 admin' : 'SeanChat admin';
    const url = isDb(app) ? `${base}/admin` : `${base}/admin?app=${app}`;
    ($('sc-open') as HTMLAnchorElement).href = url;
    ($('ok-open') as HTMLAnchorElement).href = url;
    // 오룬카는 막대(#ok-st)에 상태, 못 닿으면 「이 맥에서만 열려요」 칸(#ok-off-msg)에 이유
    $('sc-status').textContent = $('ok-st').textContent = '';
    const st = isDb(app) ? $('ok-st') : $('sc-status');
    const fail = (msg: string) => {
      frame.hidden = true;
      frame.removeAttribute('src');
      if (isDb(app)) {
        root.classList.add('ok-off');
        $('ok-off-msg').textContent = msg;
        st.textContent = '';
        return;
      }
      st.textContent = msg;
      st.className = 'status err';
    };
    st.className = 'status';
    st.textContent = '연결 확인 중…';
    // Chrome 138+ "Local Network Access": a public https page reaching 127.0.0.1 needs a
    // one-time permission. While the prompt is up the fetch just hangs, so a short
    // timeout would misreport a running backend as "응답 없음" (seen on Chrome 153).
    let perm = 'unknown';
    try {
      perm = (await navigator.permissions.query({ name: 'local-network-access' as PermissionName })).state;
    } catch {}
    if (perm === 'denied') {
      fail('브라우저가 이 사이트의 로컬 네트워크 접근을 막고 있어요 — 주소창 왼쪽 사이트 설정에서 "로컬 네트워크 액세스"를 허용하세요');
      return;
    }
    if (perm === 'prompt') st.textContent = '브라우저가 로컬 네트워크 접근 권한을 물어봅니다 → "허용"을 누르세요';
    try {
      // opaque no-cors probe: resolves if the server answers at all, rejects if unreachable
      await fetch(`${base}/health`, {
        mode: 'no-cors',
        cache: 'no-store',
        // @ts-expect-error — Chrome LNA hint; ignored elsewhere
        targetAddressSpace: 'loopback',
        signal: AbortSignal.timeout(perm === 'prompt' ? 60000 : 3000),
      });
      st.textContent = '';
      if (isDb(app)) root.classList.remove('ok-off');
      frame.hidden = false;
      if (frame.src !== url) frame.src = url;
    } catch {
      fail(
        perm === 'prompt'
          ? `${base} 연결 안 됨 — 권한 프롬프트에 응답하지 않았거나 ${label}가 꺼져 있습니다. 다시 시도를 누르면 또 확인해요`
          : `${base} 응답 없음 — ${label}가 꺼져 있거나 이 기기가 아닙니다${isDb(app) ? ' (OrunkaUnity: bash tools/admin/agent.sh status)' : ''}`
      );
    }
  }
  // ---- views (side menu): 접속자 | 앱 하나씩, 해시 #visitors · #app-<id> 로 기억 ----------------
  const LS_VIEW = 'hub.admin.view';
  // 짧은 해시(#roomlog) ↔ 화면 값(app-roomlog) — 위 appHref 와 같게
  const HASH_ALIAS: Record<string, string> = { roomlog: 'app-roomlog' };
  const hashOf = (v: string) => Object.keys(HASH_ALIAS).find((k) => HASH_ALIAS[k] === v) || v;
  function viewFromHash(): string | null {
    const h = location.hash.slice(1);
    if (h === 'visitors' || h === 'ops') return 'visitors';
    if (HASH_ALIAS[h]) return HASH_ALIAS[h];
    if (h.startsWith('app-') && APP_INFO[h.slice(4)]) return h;
    return null;
  }
  function setView(v: string, push = false) {
    let app = v.startsWith('app-') ? v.slice(4) : null;
    if (app && !APP_INFO[app]) (app = null), (v = 'visitors');
    // 오룬카 막대의 「되돌아가기」 = 들어오기 직전 화면(없으면 접속자)
    const was = localStorage.getItem(LS_VIEW);
    if (v === 'app-orunka' && was && was !== v) prevView = was;
    if (app !== 'orunka') setFull(false);
    localStorage.setItem(LS_VIEW, v);
    document.querySelectorAll<HTMLElement>('#admin .adm-view').forEach((s) => s.classList.toggle('cur', s.dataset.view === (app ? 'apps' : v)));
    document.querySelectorAll<HTMLAnchorElement>('#admin .adm-nav a').forEach((a) => {
      const on = app ? a.dataset.app === app : a.dataset.view === v;
      a.classList.toggle('on', on);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    if (location.hash !== '#' + hashOf(v)) history[push ? 'pushState' : 'replaceState'](null, '', '#' + hashOf(v));
    if (app) showApp(app);
    else ar?.setActive(false), rl?.setActive(false);
    window.scrollTo(0, 0);
    const cur = document.querySelector<HTMLElement>('#admin .adm-nav a.on');
    const nav = cur?.parentElement;
    if (cur && nav && nav.scrollWidth > nav.clientWidth) nav.scrollLeft = cur.offsetLeft - (nav.clientWidth - cur.offsetWidth) / 2;
  }
  document.querySelectorAll<HTMLAnchorElement>('#admin .adm-nav a').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      setView(a.dataset.app ? 'app-' + a.dataset.app : a.dataset.view!, true);
    })
  );
  window.addEventListener('popstate', () => {
    const v = viewFromHash();
    if (v && booted) setView(v);
  });
  // 패널 안 이동 링크(예: 에이전트 방 「전체 글은 방 기록」 = data-goto="app-roomlog")
  root.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-goto]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    setView(a.dataset.goto!, true);
  });

  // ---- boot ----------------------------------------------------------------------------
  if (DEMO || idToken()) signedIn();
  else {
    localStorage.removeItem(LS_ID);
    showGate();
  }
</script>
