---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { profile, certs, apps, posts, focus } from '../data/site';
import bedrock from '../../public/data/bedrock/seoul.json';
import bedrockMeta from '../../public/data/bedrock/meta.json';

const bStats = bedrock.stats;
const bUse1 = (bStats.reference as Record<string, { coverage_pct: number }>)['us-east-1'];
const bChecked = new Date(bedrockMeta.checked_at).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul', month: '2-digit', day: '2-digit' });

const fmtMonth = (ym: string) => ym.replace('-', '.');
// "NEW" badge for posts ≤ 14 days old at build time (the site rebuilds daily via bedrock-refresh)
const isNew = (d: string) => (Date.now() - new Date(d).getTime()) / 864e5 <= 14;
// short hero chips; the full sentence stays in the tooltip
const focusShort = ['Network · Landing Zone', 'Bedrock AI Platform', 'Kubernetes'];
const ext = { target: '_blank', rel: 'noopener' };
const me = { target: '_blank', rel: 'noopener me' };
const [roleTitle, roleOrg] = profile.role.split(' · ');
const tools = [
  { href: '/bedrock/cost/', tag: 'AWS', title: 'Bedrock 비용 계산기', sub: '서울 리전 토큰 단가로 월 비용 — 리전 · Global · 배치, us-east-1 비교', icon: 'calc' },
  { href: '/retire/', tag: 'Finance', title: '은퇴 자산 계산기', sub: '은퇴 가능 여부 · 월 가용 금액 · 자산 고갈 시점. 앱 「은퇴하면 만수르」와 같은 엔진', icon: 'trend' },
  { href: '/pension/', tag: 'Finance', title: '연금 절세 계산기', sub: '연금저축 · IRP 세액공제와 연금소득세 과세 방식 비교 (2026 세법)', icon: 'bars' },
];
const glance = [
  { href: '#tools', n: tools.length + 1, label: 'Tools' },
  { href: '#apps', n: apps.length, label: 'Apps' },
  { href: '#writing', n: posts.length, label: 'Posts' },
  { href: '#certs', n: certs.length, label: 'Certs' },
];
const credlyBadge = (id: string) => `https://www.credly.com/badges/${id}/public_url`;
---

<Base>
  <div class="home">
  <section class="hero" id="top">
    <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{roleTitle}{roleOrg && <span class="org">{roleOrg}</span>}</p>
    <h1>{profile.name}</h1>
    <p class="tagline">{profile.tagline}</p>
    <ul class="hchips">{focus.map((f, i) => <li title={f}>{focusShort[i] ?? f}</li>)}</ul>
    <div class="cta">
      <a class="btn primary" href={`mailto:${profile.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>연락하기</a>
      <a class="btn" href={profile.links.linkedin} {...me}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></svg>LinkedIn</a>
      <a class="btn" href={profile.links.github} {...me}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8l-4 4 4 4M15 8l4 4-4 4" /></svg>GitHub</a>
      <a class="btn" href={profile.links.velog} {...me}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l7 14 7-14" /></svg>velog</a>
    </div>
    <ul class="glance" aria-label="바로가기">
      {glance.map((g) => <li><a href={g.href}><b>{g.n}</b><span>{g.label}</span></a></li>)}
    </ul>
  </section>

  <section id="tools">
    <div class="shead"><h2>Tools</h2><span class="count">{tools.length + 1}</span><span class="hint">브라우저에서만 도는 계산기 · 매일 갱신되는 데이터</span></div>
    <div class="tile feature">
      <a class="f-head" href="/bedrock/">
        <span class="ticon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" /><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5" /></svg></span>
        <span class="f-title"><span class="tag">AWS · Data</span><strong>Amazon Bedrock 서울 리전 모델 현황</strong><span class="sub">있는 것 · 없는 것 · 바뀐 것 — 매일 06:00 다시 조회해 JSON · RSS로 공개</span></span>
        <span class="live"><i></i>LIVE</span>
      </a>
      <div class="nums">
        <div><b>{bStats.primary_models}</b><span>서울 모델</span></div>
        <div><b>{bStats.on_demand}</b><span>on-demand</span></div>
        <div><b>{bUse1.coverage_pct}<small>%</small></b><span>us-east-1 대비</span><em style={`--p:${bUse1.coverage_pct}%`}></em></div>
        <div><b>{bStats.missing_bases}</b><span>서울에 없음</span></div>
      </div>
      <div class="f-foot">
        <span class="meta">확인 {bChecked} · <a href="/data/bedrock/seoul.json">JSON</a> · <a href="/data/bedrock/feed.xml">RSS</a></span>
        <a class="go" href="/bedrock/">카탈로그 보기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <ul class="tgrid">
      {tools.map((t) => (
        <li><a class="tile tcard" href={t.href}>
          <span class="ticon" aria-hidden="true">
            {t.icon === 'calc' && <svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2M8 18h8" /></svg>}
            {t.icon === 'trend' && <svg viewBox="0 0 24 24"><path d="M3 20h18" /><path d="M6 16v-4M11 16V9M16 16V6" /><path d="M14 6h4v4" /></svg>}
            {t.icon === 'bars' && <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /><path d="M14 7l3-3 3 3" /></svg>}
          </span>
          <span class="tag">{t.tag}</span>
          <strong>{t.title}</strong>
          <span class="sub">{t.sub}</span>
          <span class="go">계산하기 <span aria-hidden="true">→</span></span>
        </a></li>
      ))}
    </ul>
  </section>
  <section id="apps">
    <div class="shead"><h2>Apps</h2><span class="count">{apps.length}</span><span class="hint">iOS · App Store</span></div>
    <ul class="agrid">
      {apps.map((a) => (
        <li><a class="tile acard" href={a.url} {...ext}>
          <img src={a.icon} alt="" width="56" height="56" loading="lazy" />
          <span class="a-body">
            <strong>{a.name}</strong>
            <span class="sub">{a.subtitle}</span>
            <span class="a-foot"><span>{a.category} · v{a.version}</span><span class="go">App Store <span aria-hidden="true">↗</span></span></span>
          </span>
        </a></li>
      ))}
    </ul>
  </section>

  <section id="writing">
    <div class="shead"><h2>Writing</h2><span class="count">{posts.length}</span><a class="hint link" href={profile.links.velog} {...ext}>velog 전체 보기 ↗</a></div>
    <ol class="plist">
      {posts.map((p) => (
        <li><a href={p.url} {...ext}>
          <time datetime={p.date}><b>{p.date.slice(5).replace('-', '.')}</b><small>{p.date.slice(0, 4)}</small></time>
          <span class="t">{isNew(p.date) && <span class="new">NEW</span>}{p.title}</span>
          <span class="arr" aria-hidden="true">→</span>
        </a></li>
      ))}
    </ol>
    <p class="pmore"><a href={profile.links.rss} {...ext}>RSS 구독</a></p>
  </section>

  <section id="certs">
    <div class="shead"><h2>Certifications</h2><span class="count">{certs.length}</span><a class="hint link" href={profile.links.credly} {...me}>Credly 프로필 ↗</a></div>
    <ul class="badges">
      {certs.map((c) => (
        <li><a href={credlyBadge(c.badge)} {...ext} title={`${c.name} · ${fmtMonth(c.earned)}${c.expires ? ` → ${fmtMonth(c.expires)}` : ''} — Credly에서 확인`}>
          <img src={c.img} alt="" width="56" height="56" loading="lazy" />
          <strong>{c.short}</strong>
          <span>{c.issuer} · {c.earned.slice(0, 4)}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section id="contact">
    <div class="shead"><h2>Contact</h2></div>
    <a class="tile ccard" href={`mailto:${profile.email}`}>
      <span class="ticon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg></span>
      <span class="c-body"><strong>{profile.email}</strong><span class="sub">{profile.location} · 메일이 가장 빠릅니다</span></span>
      <span class="go" aria-hidden="true">→</span>
    </a>
  </section>
  </div>
</Base>

<!-- styles: src/styles/home.css (global, namespaced under .home — card markup is shared across sections) -->

