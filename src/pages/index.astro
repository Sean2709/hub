---
import Base from '../layouts/Base.astro';
import { profile, certs, apps, posts, focus } from '../data/site';
import bedrock from '../../public/data/bedrock/seoul.json';
import bedrockMeta from '../../public/data/bedrock/meta.json';

const bStats = bedrock.stats;
const bUse1 = (bStats.reference as Record<string, { coverage_pct: number }>)['us-east-1'];
const bChecked = new Date(bedrockMeta.checked_at).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul', month: '2-digit', day: '2-digit' });

const fmtMonth = (ym: string) => {
  const [y, m] = ym.split('-');
  return `${y}.${m}`;
};
const initials = profile.name.slice(0, 1);
---

<Base>
  <section class="hero" id="top">
    <div class="avatar" aria-hidden="true">{initials}</div>
    <div>
      <h1>{profile.name}</h1>
      <p class="role">
        {profile.role} <span class="sep">@</span> {profile.org}
      </p>
      <p class="tagline">{profile.tagline}</p>
      <ul class="focus">
        {focus.map((f) => <li>{f}</li>)}
      </ul>
      <div class="cta">
        <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
        <a class="btn" href={profile.links.github} target="_blank" rel="noopener me">GitHub</a>
        <a class="btn" href={profile.links.velog} target="_blank" rel="noopener me">velog</a>
      </div>
    </div>
  </section>

  <section id="tools">
    <h2>Tools <span class="count">1</span></h2>
    <ul class="grid tools">
      <li class="card tool">
        <div class="app-head">
          <strong><a href="/bedrock/">Amazon Bedrock 서울 리전 모델 현황</a></strong>
          <span class="pill">매일 갱신</span>
        </div>
        <p class="sub">ap-northeast-2에 지금 있는 것 · 없는 것 · 바뀐 것 — API 응답을 매일 다시 조회해 JSON·RSS로 공개</p>
        <div class="nums">
          <div><b>{bStats.primary_models}</b><span>서울 모델</span></div>
          <div><b>{bStats.on_demand}</b><span>on-demand</span></div>
          <div><b>{bUse1.coverage_pct}%</b><span>us-east-1 대비</span></div>
          <div><b>{bStats.missing_bases}</b><span>서울에 없음</span></div>
        </div>
        <div class="app-foot">
          <span class="meta">확인 {bChecked} · <a class="link" href="/data/bedrock/seoul.json">JSON</a> · <a class="link" href="/data/bedrock/feed.xml">RSS</a></span>
          <a class="link" href="/bedrock/">보기 →</a>
        </div>
      </li>
    </ul>
  </section>

  <section id="apps">
    <h2>Apps <span class="count">{apps.length}</span></h2>
    <ul class="grid apps">
      {apps.map((a) => (
        <li class="card app">
          <div class="app-head">
            <strong>{a.name}</strong>
            <span class="pill">{a.category}</span>
          </div>
          <p class="sub">{a.subtitle}</p>
          <p class="desc">{a.desc}</p>
          <div class="app-foot">
            <span class="meta">v{a.version} · {a.released}</span>
            <a class="link" href={a.url} target="_blank" rel="noopener">App Store →</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="writing">
    <h2>Writing <span class="count">{posts.length}</span></h2>
    <ol class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.date}>{p.date}</time>
          <a href={p.url} target="_blank" rel="noopener">{p.title}</a>
          <span class="tags">{p.tags.map((t) => <span class="tag">#{t}</span>)}</span>
        </li>
      ))}
    </ol>
    <p class="more">
      전체 글: <a href={profile.links.velog} target="_blank" rel="noopener">velog @seanson2709</a>
      <span class="dot">·</span>
      <a href={profile.links.rss} target="_blank" rel="noopener">RSS</a>
    </p>
  </section>

  <section id="certs">
    <h2>Certifications <span class="count">{certs.length}</span></h2>
    <ul class="grid certs">
      {certs.map((c) => (
        <li class={`card cert level-${c.level.toLowerCase()}`}>
          <div class="cert-head">
            <span class="issuer">{c.issuer}</span>
            <span class="level">{c.level}</span>
          </div>
          <strong class="cert-name">{c.name}</strong>
          <span class="meta">
            {fmtMonth(c.earned)}
            {c.expires && <> → {fmtMonth(c.expires)}</>}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <ul class="contact">
      <li><span class="k">Email</span><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
      <li><span class="k">LinkedIn</span><a href={profile.links.linkedin} target="_blank" rel="noopener me">seungwoo-son</a></li>
      <li><span class="k">GitHub</span><a href={profile.links.github} target="_blank" rel="noopener me">Sean2709</a></li>
      <li><span class="k">Location</span><span>{profile.location}</span></li>
    </ul>
  </section>
</Base>
