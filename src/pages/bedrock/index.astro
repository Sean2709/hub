---
import Base from '../../layouts/Base.astro';
import seoul from '../../../public/data/bedrock/seoul.json';
import profilesData from '../../../public/data/bedrock/profiles.json';
import changesData from '../../../public/data/bedrock/changes.json';
import meta from '../../../public/data/bedrock/meta.json';

type Model = (typeof seoul.models)[number];
type Missing = (typeof seoul.missing)[number];
type Profile = (typeof profilesData.profiles)[number];
type Change = {
  date: string;
  type: 'baseline' | 'diff';
  region: string;
  count?: number;
  added?: { id: string; name: string; provider: string }[];
  removed?: { id: string; name: string; provider: string }[];
  changed?: { id: string; name: string; field: string; from: unknown; to: unknown }[];
};

const REGION = seoul.region;
const stats = seoul.stats;
const models: Model[] = seoul.models;
const missing: Missing[] = seoul.missing;
const profiles: Profile[] = profilesData.profiles;
const changes = (changesData as Change[]).slice(0, 30);

const REGION_LABEL: Record<string, string> = {
  'ap-northeast-2': '서울',
  'ap-northeast-1': '도쿄',
  'us-east-1': '버지니아',
  'us-west-2': '오레곤',
  'us-east-2': '오하이오',
};
const REGION_SHORT: Record<string, string> = {
  'us-east-1': 'use1',
  'us-west-2': 'usw2',
  'us-east-2': 'use2',
  'ap-northeast-1': 'apne1',
};

const checked = new Date(meta.checked_at);
const checkedKST = checked.toLocaleString('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
});

const providers = stats.providers as string[];
const ref = stats.reference as Record<string, { models: number; bases: number; shared_bases: number; coverage_pct: number }>;
const use1 = ref['us-east-1'];

// missing grouped by provider
const missingByProvider = new Map<string, Missing[]>();
for (const m of missing) {
  const arr = missingByProvider.get(m.provider) ?? [];
  arr.push(m);
  missingByProvider.set(m.provider, arr);
}
const missingGroups = [...missingByProvider.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));

const profileGroups = new Map<string, Profile[]>();
for (const p of profiles) {
  const arr = profileGroups.get(p.scope) ?? [];
  arr.push(p);
  profileGroups.set(p.scope, arr);
}

const mod = (xs: string[]) => xs.map((x) => x[0] + x.slice(1).toLowerCase()).join(' + ');
const fmtVal = (v: unknown) => (Array.isArray(v) ? (v.length ? v.join(',') : '∅') : String(v ?? '∅'));

const title = `Amazon Bedrock 서울 리전 모델 현황 — ${stats.primary_models}개, 매일 갱신`;
const description = `ap-northeast-2에서 지금 쓸 수 있는 Bedrock 파운데이션 모델 ${stats.primary_models}개(on-demand ${stats.on_demand}, CRIS 전용 ${stats.cris_only}), us-east-1 대비 ${use1.coverage_pct}% 커버. 서울에 없는 모델 ${stats.missing_bases}개 목록, 추론 프로필, 변경 이력 RSS/JSON.`;
---

<Base title={title} description={description} wide>
  <section class="page-head">
    <h1>Amazon Bedrock, 서울 리전에서 지금 쓸 수 있는 모델</h1>
    <p class="lead">
      <code>{REGION}</code>의 <code>bedrock:ListFoundationModels</code>·<code>ListInferenceProfiles</code> 응답을 매일 06:00 KST에 다시 조회해 자동 갱신합니다.
      콘솔 카탈로그를 리전마다 뒤지지 않아도 되도록 — 서울에 있는 것, 없는 것, 바뀐 것을 한 페이지에.
    </p>
    <p class="checked">
      마지막 확인 <b><time datetime={meta.checked_at}>{checkedKST} KST</time></b>
      <span class="dot">·</span> 원본 데이터 <a href="/data/bedrock/seoul.json">JSON</a> · <a href="/data/bedrock/feed.xml">RSS</a>
      <span class="dot">·</span> <a href="https://github.com/Sean2709/hub/blob/main/scripts/gen_bedrock.py" target="_blank" rel="noopener">생성 스크립트</a>
    </p>
    <ul class="stats">
      <li class="stat accent"><span class="n">{stats.primary_models}</span><span class="l">서울 모델 (base {stats.primary_bases})</span></li>
      <li class="stat"><span class="n">{stats.on_demand}</span><span class="l">On-demand 호출 가능</span></li>
      <li class="stat"><span class="n">{stats.cris_only}</span><span class="l">추론 프로필(CRIS) 전용</span></li>
      <li class="stat"><span class="n">{use1.coverage_pct}%</span><span class="l">us-east-1 대비 ({use1.shared_bases}/{use1.bases})</span></li>
      <li class="stat"><span class="n">{stats.missing_bases}</span><span class="l">서울에 없는 모델</span></li>
    </ul>
  </section>

  <section id="models">
    <h2>서울에서 쓸 수 있는 모델 <span class="count">{models.length}</span></h2>
    <div class="filters" role="search">
      <input id="q" type="search" placeholder="모델명 · ID 검색 (예: claude, nova, embed)" aria-label="모델 검색" autocomplete="off" />
      <select id="prov" aria-label="제공자">
        <option value="">모든 제공자</option>
        {providers.map((p) => <option value={p}>{p}</option>)}
      </select>
      <select id="acc" aria-label="접근 방식">
        <option value="">모든 접근 방식</option>
        <option value="on-demand">On-demand</option>
        <option value="cris">CRIS 프로필</option>
        <option value="none">접근 경로 없음</option>
      </select>
      <span class="hint"><span id="shown">{models.length}</span> / {models.length}</span>
    </div>
    <div class="tablewrap">
      <table class="models" id="tbl">
        <colgroup>
          <col class="c-prov" /><col class="c-name" /><col class="c-id" /><col class="c-io" /><col class="c-stream" /><col class="c-acc" /><col class="c-since" />
        </colgroup>
        <thead>
          <tr>
            <th>Provider</th><th>Model</th><th>Model ID</th><th>In → Out</th><th>Stream</th><th>Access</th><th>Since</th>
          </tr>
        </thead>
        <tbody>
          {models.map((m) => (
            <tr
              class:list={[{ legacy: m.status === 'LEGACY' }]}
              data-q={`${m.name} ${m.id} ${m.provider}`.toLowerCase()}
              data-prov={m.provider}
              data-acc={m.access.length ? m.access.join(' ') : 'none'}
            >
              <td>{m.provider}</td>
              <td class="name">{m.name}{m.id !== m.base && <span class="variant">{m.id.slice(m.base.length + 1)}</span>}</td>
              <td><code>{m.id}</code></td>
              <td>{mod(m.input)} → {mod(m.output)}</td>
              <td class="muted">{m.streaming ? '✓' : '—'}</td>
              <td>
                {m.access.includes('on-demand') && <span class="badge od">On-demand</span>}
                {m.access.includes('cris') && <span class="badge cris">CRIS</span>}
                {m.access.includes('provisioned') && <span class="badge">Provisioned</span>}
                {!m.access.length && <span class="badge none">—</span>}
                {m.profiles.length > 0 && (
                  <div class="chips">{m.profiles.map((p) => <span class="chip">{p}</span>)}</div>
                )}
              </td>
              <td class="muted nowrap">{m.since ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      <b>Access</b> — <span class="badge od">On-demand</span>는 <code>modelId</code>로 직접 호출, <span class="badge cris">CRIS</span>는 표시된 추론 프로필 ID(<code>apac.*</code>/<code>global.*</code>)로만 호출 가능(cross-region inference). 접근 경로가 없는 항목은 카탈로그에만 있는 컨텍스트 변형(provisioned 전용)입니다.
      카탈로그 기준이라 계정별 모델 액세스 승인·쿼터·요금은 반영하지 않습니다.
    </p>
  </section>

  <section id="missing">
    <h2>서울에 없는 모델 <span class="count">{missing.length}</span></h2>
    <p class="legend">
      추적 리전 중 하나 이상에서 제공되지만 서울엔 없는 base 모델(컨텍스트 변형은 하나로 합침).
      리전 약어: {Object.entries(REGION_SHORT).map(([r, s], i) => (
        <>{i > 0 && ' · '}<code>{s}</code> {REGION_LABEL[r]} ({ref[r].models})</>
      ))}
    </p>
    <ul class="missing">
      {missingGroups.map(([prov, items]) => (
        <li>
          <span class="prov">{prov}<span class="count">{items.length}</span></span>
          <span class="items">
            {items.map((m) => (
              <span class="item" title={m.base}>
                {m.name}<span class="r">{m.regions.map((r) => REGION_SHORT[r] ?? r).join(' ')}</span>
              </span>
            ))}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section id="profiles">
    <h2>서울에서 쓸 수 있는 추론 프로필 <span class="count">{profiles.length}</span></h2>
    <p class="legend">
      시스템 정의 cross-region inference 프로필. <code>apac.*</code>은 APAC 리전 묶음으로 라우팅, <code>global.*</code>은 글로벌 엔드포인트(요청은 서울에서 나가지만 처리 리전은 AWS가 선택).
      데이터 상주 요건이 있으면 라우팅 대상 리전을 확인하세요.
    </p>
    {[...profileGroups.entries()].map(([scope, ps]) => (
      <details class="group" open={scope === 'apac'}>
        <summary><code>{scope}.*</code><span class="count">{ps.length}</span></summary>
        <ul class="profiles">
          {ps.map((p) => (
            <li>
              <code>{p.id}</code>
              <span class="regions">{p.global_endpoint ? 'global endpoint' : p.regions.join(' ')}</span>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </section>

  <section id="changes">
    <h2>변경 이력 <span class="count">{changes.length}</span></h2>
    <p class="legend">매일 이전 스냅샷과 비교해 추가·제거·속성 변경(status, inference type, modality, EOL)을 기록합니다. <a href="/data/bedrock/feed.xml">RSS로 구독</a>하면 서울에 새 모델이 열리는 날 알 수 있습니다.</p>
    <ul class="changes">
      {changes.map((c) => (
        <li>
          <time datetime={c.date}>{c.date}</time>
          <div>
            <span class="region">{c.region}</span>
            {c.type === 'baseline' ? (
              <span class="muted">첫 스냅샷 — {c.count}개 모델</span>
            ) : (
              <>
                {c.added?.length ? <span class="add">+{c.added.length}</span> : null}
                {c.removed?.length ? <span class="rm"> −{c.removed.length}</span> : null}
                {c.changed?.length ? <span class="chg"> ~{c.changed.length}</span> : null}
                <ul>
                  {c.added?.map((a) => <li class="add">추가 {a.name} <code>{a.id}</code></li>)}
                  {c.removed?.map((r) => <li class="rm">제거 {r.name} <code>{r.id}</code></li>)}
                  {c.changed?.map((x) => <li class="chg">{x.name} · {x.field}: {fmtVal(x.from)} → {fmtVal(x.to)}</li>)}
                </ul>
              </>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="data">
    <h2>데이터로 쓰기</h2>
    <p class="legend">페이지는 껍데기고 산출물은 아래 파일입니다. 그대로 가져다 쓰세요 (CORS 허용, 인증 없음, 매일 갱신). 파생 데이터는 CC0.</p>
    <ul class="datalist">
      <li><span class="k">seoul.json</span><span><a href="/data/bedrock/seoul.json">/data/bedrock/seoul.json</a> — 서울 모델 + 접근 경로 + 부재 목록 + 통계</span></li>
      <li><span class="k">models.json</span><span><a href="/data/bedrock/models.json">/data/bedrock/models.json</a> — 추적 리전 {meta.regions.length}곳 전체 원본 정규화</span></li>
      <li><span class="k">profiles.json</span><span><a href="/data/bedrock/profiles.json">/data/bedrock/profiles.json</a> — 서울 추론 프로필과 라우팅 리전</span></li>
      <li><span class="k">changes.json</span><span><a href="/data/bedrock/changes.json">/data/bedrock/changes.json</a> — 변경 이력 (최신순)</span></li>
      <li><span class="k">feed.xml</span><span><a href="/data/bedrock/feed.xml">/data/bedrock/feed.xml</a> — 변경 이력 RSS 2.0</span></li>
      <li><span class="k">meta.json</span><span><a href="/data/bedrock/meta.json">/data/bedrock/meta.json</a> — 마지막 확인 시각·소스</span></li>
    </ul>
<pre class="code"><code># 서울에서 on-demand로 바로 부를 수 있는 모델 ID
curl -s https://hub.sean-chloe.com/data/bedrock/seoul.json \
  | jq -r '.models[] | select(.access | index("on-demand")) | .id'

# Claude 계열이 서울에서 어떤 프로필로 열려 있나
curl -s https://hub.sean-chloe.com/data/bedrock/seoul.json \
  | jq -r '.models[] | select(.provider=="Anthropic") | "\(.name)\t\(.profiles|join(","))"'</code></pre>
    <p class="note">
      소스: AWS Bedrock 컨트롤플레인 API 공개 카탈로그 응답. 프롬프트 캐싱·툴 사용·구조화 출력 같은 <em>기능</em> 지원 여부는 API가 돌려주지 않아 포함하지 않았습니다(문서 기반 오버레이는 다음 단계).
      틀린 점·추가 리전 요청은 <a href="https://github.com/Sean2709/hub/issues" target="_blank" rel="noopener">GitHub 이슈</a>로.
    </p>
  </section>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const prov = document.getElementById('prov') as HTMLSelectElement;
  const acc = document.getElementById('acc') as HTMLSelectElement;
  const shown = document.getElementById('shown')!;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#tbl tbody tr'));

  const apply = () => {
    const needle = q.value.trim().toLowerCase();
    const p = prov.value;
    const a = acc.value;
    let n = 0;
    for (const r of rows) {
      const ok =
        (!needle || (r.dataset.q ?? '').includes(needle)) &&
        (!p || r.dataset.prov === p) &&
        (!a || (r.dataset.acc ?? '').split(' ').includes(a));
      r.hidden = !ok;
      if (ok) n++;
    }
    shown.textContent = String(n);
    const params = new URLSearchParams();
    if (needle) params.set('q', needle);
    if (p) params.set('provider', p);
    if (a) params.set('access', a);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}#models` : location.pathname);
  };

  const init = new URLSearchParams(location.search);
  if (init.get('q')) q.value = init.get('q')!;
  if (init.get('provider')) prov.value = init.get('provider')!;
  if (init.get('access')) acc.value = init.get('access')!;
  q.addEventListener('input', apply);
  prov.addEventListener('change', apply);
  acc.addEventListener('change', apply);
  apply();
</script>
